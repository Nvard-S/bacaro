# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed -- these are live API keys.

# Google Places API (New) -- used for collecting bars and geocoding
# location-aware search queries.
GOOGLE_PLACES_API_KEY=

# Parallel Extract API -- used for scraping cicchetti content and
# best-effort Instagram links from bar websites.
PARALLEL_API_KEY=

# OpenAI API -- used for embeddings, the RAG search chat model, tag/blurb
# classification, and location-reference detection.
OPENAI_API_KEY=

# Storage backend: "sqlite" (default, uses the local venice_bars.db +
# chroma_db/) or "postgres" (uses Supabase Postgres + pgvector, requires
# DATABASE_URL below).
DATA_BACKEND=sqlite

# Supabase Postgres connection string. Only required when DATA_BACKEND=postgres.
DATABASE_URL=
